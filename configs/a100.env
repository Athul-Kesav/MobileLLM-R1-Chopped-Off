# Single-node A100 profile. Same repo-relative paths as configs/train.env.
# After clone, the only typical edits are NPROC_PER_NODE and MASTER_ADDR.

PYTHON="${PYTHON:-python}"
NNODES=1
NPROC_PER_NODE=auto
NODE_RANK=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500

MODEL_SIZE=140m
MODEL_ROOT=models
DATA_ROOT=data
OUTPUT_ROOT=checkpoints
LOG_ROOT=logs
HF_HOME=.hf_cache

USE_LOCAL_SHISHU_MODEL=1
SHISHU_MODEL_DIR=models/MobileLLM-R1-140M-shishu
PRETRAIN_INIT=checkpoint

PRETRAIN_PHASE1_DATA=data/pretrain/phase1
PRETRAIN_PHASE2_DATA=data/pretrain/phase2
MIDTRAIN_PHASE1_DATA=data/midtrain/phase1
MIDTRAIN_PHASE2_DATA=data/midtrain/phase2
GENERAL_SFT_DATASET=data/sft/general
REASONING_SFT_DATASET=data/sft/reasoning
REASONING_SFT_DATASET_CONFIG=

# 8xA100 80GB can take a larger per-device batch. Raise *_STEPS for a longer run.
PRETRAIN_SEQ_LEN=2048
PRETRAIN_BATCH=16
PRETRAIN_GRAD_ACCUM=1
PRETRAIN_GRAD_CKPT=True
PRETRAIN_LR=4e-3
PRETRAIN_WARMUP=2000
PRETRAIN_MIN_LR_RATIO=0.1
PRETRAIN_PHASE1_STEPS=500000
PRETRAIN_PHASE2_STEPS=500000
PRETRAIN_SAVE_STEPS=1000
PRETRAIN_BUFFER_SIZE=2048

MIDTRAIN_SEQ_LEN=4096
MIDTRAIN_BATCH=4
MIDTRAIN_GRAD_ACCUM=1
MIDTRAIN_LR=3.6e-4
MIDTRAIN_WARMUP=0
MIDTRAIN_PHASE1_STEPS=50000
MIDTRAIN_PHASE2_STEPS=50000
MIDTRAIN_SAVE_STEPS=1000
MIDTRAIN_BUFFER_SIZE=2048

SFT_GENERAL_SEQ_LEN=4096
SFT_GENERAL_BATCH=4
SFT_GENERAL_GRAD_ACCUM=1
SFT_GENERAL_LR=5e-6
SFT_GENERAL_EPOCHS=2
SFT_GENERAL_MAX_STEPS=-1
SFT_REASONING_SEQ_LEN=8192
SFT_REASONING_BATCH=2
SFT_REASONING_GRAD_ACCUM=1
SFT_REASONING_LR=8e-5
SFT_REASONING_EPOCHS=4
SFT_REASONING_MAX_STEPS=-1
SFT_SAVE_STEPS=1000
USE_LIGER_KERNEL=True
