# Copy to configs/full_training.env and edit every path/revision before running.
# Do not put HF_TOKEN in this file.

MODEL_SIZE=950m
MODEL_ROOT=/mnt/models/mobilellm-r1
DATA_ROOT=/mnt/data/mobilellm-r1
OUTPUT_ROOT=/mnt/checkpoints/mobilellm-r1
LOG_ROOT=/mnt/logs/mobilellm-r1

# The base model supplies config/tokenizer for pretraining and the initial
# weights for post-training. Set the exact resolved SHA from the Hub.
BASE_MODEL_ID=facebook/MobileLLM-R1-950M-base
BASE_MODEL_REVISION=REPLACE_WITH_RESOLVED_SHA
FINAL_MODEL_ID=facebook/MobileLLM-R1-950M
FINAL_MODEL_REVISION=REPLACE_WITH_RESOLVED_SHA

# Mid-training KD teacher; this must be a locally available, licensed model.
TEACHER_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
TEACHER_MODEL_PATH=/mnt/models/Llama-3.1-8B-Instruct

# Dataset roots must contain numbered node directories: 1/ ... 16/.
PRETRAIN_PHASE1_DATA=${DATA_ROOT}/pretrain/phase1
PRETRAIN_PHASE2_DATA=${DATA_ROOT}/pretrain/phase2
MIDTRAIN_PHASE1_DATA=${DATA_ROOT}/midtrain/phase1
MIDTRAIN_PHASE2_DATA=${DATA_ROOT}/midtrain/phase2

# Post-training datasets are passed to the upstream TRL script.
GENERAL_SFT_DATASET=allenai/tulu-3-sft-olmo-2-mixture-0225
REASONING_SFT_DATASET_CONFIG=dataset_chatml_format
REASONING_SFT_DATASET_ID=nvidia/OpenMathReasoning
EVAL_DATA_ROOT=${DATA_ROOT}/evaluation

NNODES=16
NPROC_PER_NODE=8
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500
HF_HOME=/mnt/cache/huggingface
