# Layerwise distillation on top of the logit-KD ShiShu checkpoint.
# Blocks 0-14 match the teacher block of the same index. Block 15 stays with the logit loss.

PYTHON=
# Same two GPUs as the reported run. Auto would change the batch if a third card is free.
CUDA_VISIBLE_DEVICES=0,2
NPROC_PER_NODE=2
MASTER_ADDR=127.0.0.1
MASTER_PORT=29532

STUDENT=kd/runs/shishu
TEACHER=models/MobileLLM-R1-140M
DATA_GENERAL=compare/data/general/train.jsonl
DATA_REASONING=compare/data/reasoning/train.jsonl
OUTPUT_DIR=kd/runs/shishu-layerwise
LOG_DIR=kd/logs
SEED=140

SEQ_LEN=2048
BATCH=1
ACCUM=4
EPOCHS=2
MAX_STEPS=-1
LR=2e-5
WARMUP=0.03
TEMPERATURE=1.0
KL_COEF=1.0
CE_COEF=0.1
LAYER_COEF=1.0

LOGGING_STEPS=10
SAVE_STEPS=50
