# ShiShu initialized by copying the fully trained MobileLLM-R1-140M.
# The launcher builds STUDENT from TRANSPLANT_FROM when its weights are absent.
# Blocks 0-10 are copied whole. Blocks 11-14 keep the MLP and drop attention.
# Block 15 starts as a residual identity. Training is the layerwise KD loss.

PYTHON=
# Same two GPUs as the other reported runs.
CUDA_VISIBLE_DEVICES=0,2
NPROC_PER_NODE=2
MASTER_ADDR=127.0.0.1
MASTER_PORT=29533

TRANSPLANT_FROM=models/MobileLLM-R1-140M
STUDENT=kd/runs/shishu-transplant
TEACHER=models/MobileLLM-R1-140M
DATA_GENERAL=compare/data/general/train.jsonl
DATA_REASONING=compare/data/reasoning/train.jsonl
OUTPUT_DIR=kd/runs/shishu-transplant-kd
LOG_DIR=kd/logs
SEED=140

SEQ_LEN=2048
BATCH=1
ACCUM=4
EPOCHS=2
MAX_STEPS=-1
LR=1e-5
WARMUP=0.03
TEMPERATURE=1.0
KL_COEF=1.0
CE_COEF=0.1
LAYER_COEF=1.0

LOGGING_STEPS=10
SAVE_STEPS=50
