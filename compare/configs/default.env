# Same post-training loop for MobileLLM-R1-140M-shishu and MobileLLM-R1-140M-base.
# Facebook's recipe: Tulu-3 general SFT, then OpenMathReasoning SFT.
# Paper schedule (866K / 3.2M rows, seq 4k then 32k) is commented beside each knob.
# Defaults train the local subsets already in data/sft for the full epoch counts.

PYTHON=
# Reported runs used two processes on GPUs 0 and 2. Auto-picking a third
# free GPU would change the batch and would not replay these checkpoints.
CUDA_VISIBLE_DEVICES=0,2
NPROC_PER_NODE=2
MASTER_ADDR=127.0.0.1
MASTER_PORT=29521

SHISHU_DIR=models/MobileLLM-R1-140M-shishu
BASE_REPO=facebook/MobileLLM-R1-140M-base
BASE_DIR=models/MobileLLM-R1-140M-base
CHAT_TEMPLATE=models/MobileLLM-R1-140M-shishu/chat_template.jinja

# Local copies of allenai/tulu-3-sft-olmo-2-mixture-0225 and nvidia/OpenMathReasoning.
SOURCE_GENERAL=data/sft/general/train.jsonl
SOURCE_REASONING=data/sft/reasoning/train.jsonl
COMPARE_DATA=compare/data
# Split seed for the held-out rows and the GSM8K slice.
SEED=140
# Shuffle seed used by the reported SFT runs. It was the Trainer default.
SFT_SEED=42
EVAL_ROWS=128
GSM8K_ROWS=64

RUN_ROOT=compare/runs
LOG_ROOT=compare/logs
RESULT_ROOT=compare/results

# Paper general SFT: seq 4096, batch 4, lr 5e-6, warmup 0.03, linear, 2 epochs, wd 0.
SEQ_LEN=2048
GENERAL_LR=5e-6
GENERAL_WARMUP=0.03
GENERAL_EPOCHS=2
GENERAL_MAX_STEPS="${GENERAL_MAX_STEPS:--1}"
GENERAL_BATCH=2
GENERAL_ACCUM=1
GENERAL_SCHEDULER=linear

# Paper reasoning SFT: seq 32768, batch 8, lr 8e-5, warmup 0.1, cosine, 4 epochs, wd 0.
REASONING_LR=8e-5
REASONING_WARMUP=0.1
REASONING_EPOCHS=4
REASONING_MAX_STEPS="${REASONING_MAX_STEPS:--1}"
REASONING_BATCH=1
REASONING_ACCUM=2
REASONING_SCHEDULER=cosine

SAVE_STEPS=50
USE_LIGER_KERNEL=False

PPL_MAX_SEQS=64
ACCURACY_PROBLEMS=32
ACCURACY_MAX_NEW_TOKENS=256
LATENCY_REPEATS=8
LATENCY_NEW_TOKENS=32
THROUGHPUT_BATCH=4
THROUGHPUT_NEW_TOKENS=32
